# connect 服务需要与 new-api 共享同一个 SESSION_SECRET
SESSION_SECRET=your-new-api-session-secret-here

# SQLite 数据库路径
DATABASE_URL=sqlite:connect.db?mode=rwc

# 监听地址
LISTEN_ADDR=0.0.0.0:4000

# new-api 登录页地址（用户未登录时跳转）
LOGIN_URL=https://dli.li/sign-in

# 路径前缀（同域部署时设置，如 /connect）
# 设置后所有路由挂载在该前缀下：/connect/authorize, /connect/token 等
# 留空或不设置则路由在根路径下
BASE_PATH=/connect

# new-api API 基础地址（用于获取用户完整信息）
API_BASE_URL=http://127.0.0.1:3000

# ========== OIDC 配置 ==========

# Issuer URL（必需，OIDC Provider 的标识符）
# 示例：https://dli.li/connect 或 https://connect.example.com
ISSUER_URL=https://dli.li/connect

# 私钥文件路径（可选，默认 keys/private.pem）
# 首次启动时如果不存在会自动生成
PRIVATE_KEY_PATH=keys/private.pem

# ID Token 签名算法（可选，默认 RS256）
# 支持：RS256, ES256, PS256
ID_TOKEN_SIGNING_ALG=RS256

# ID Token 过期时间（秒，可选，默认 900 = 15 分钟）
ID_TOKEN_EXPIRES_IN=900

# Refresh Token 过期时间（秒，可选，默认 2592000 = 30 天）
REFRESH_TOKEN_EXPIRES_IN=2592000
